model Department {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  employees Employee[]
}

model Employee {
  id           Int               @id @default(autoincrement())
  name         String
  email        String            @unique
  phone        String
  departmentId Int
  department   Department        @relation(fields: [departmentId], references: [id])
  designation  String
  salary       Int
  createdAt    TimestamptzString @default(now())
}